FROM alpine
LABEL vendor=DHUniWien

RUN apk update \
 && apk upgrade \
 && apk add --no-cache \
    bash \
    gcc \
    make \
    libxml2 \
    libxml2-dev \
    zlib \
    zlib-dev \
    expat \
    graphviz \
    tzdata \
    wget \
    gmp \
    gmp-dev \
    expat \
    expat-dev \
    openssl \
    openssl-dev \
    openssh \
    libc-dev \
    perl \
    perl-dev 

# download, compile and install Phylip Pars
WORKDIR /tmp
RUN wget https://phylipweb.github.io/phylip/download/phylip-3.697.tar.gz \
 && tar -xzvf phylip-3.697.tar.gz
WORKDIR /tmp/phylip-3.697/src
RUN sed -e 's/^CFLAGS =/CFLAGS = -fcommon -Wno-error=implicit-function-declaration/' Makefile.unx > Makefile \
 && make install \
 && cp ../exe/pars /usr/local/bin

# get what modules we can that don't install cleanly from CPANM
RUN apk add --no-cache \
    perl-plack \
    perl-crypt-rijndael \
    perl-net-ssleay \
    perl-json-webtoken \
    perl-io-socket-ssl \
    perl-ipc-system-simple

RUN wget https://cpanmin.us -O cpanm && perl cpanm App::cpanminus

# tests here will fail in the build container
# and I don't feel like installing perl-doc just for one test in IO::All
RUN cpanm --notest IO::All

# install the other ones honestly, with tests
# First get the modules whose dependents don't record them accurately
# enough for cpanm to notice they are needed
RUN cpanm \
    Cookie::Baker \
    Devel::OverloadInfo \
    HTTP::Entity::Parser \
    HTTP::Headers::Fast \
    Module::Install::Catalyst \
    Class::Accessor::Fast \
    || (cat /root/.cpanm/work/*/build.log; exit 1)

# Then get the modules referenced directly in the Makefile.PL
WORKDIR /tmp
COPY Makefile.PL /tmp
RUN grep requires Makefile.PL | \
    cut -d ' ' -f 2 | \
    sed -e 's/;//' | \
    xargs cpanm && rm Makefile.PL
